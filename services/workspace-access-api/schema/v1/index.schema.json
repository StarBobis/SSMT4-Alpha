{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssmt4.dev/schema/v1/index.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "gamePreset", "generatedAt", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 }, "gamePreset": { "type": "string" }, "generatedAt": { "type": "string", "format": "date-time" },
    "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["entryId", "workspaceName", "attribution", "attributionVerified", "uploadedAt", "capturedAt", "drawIB", "aliases", "fullDataAvailable", "fullDataSize", "availability", "reviewState", "metadataPath"], "properties": { "entryId": { "type": "string" }, "gamePreset": { "type": "string" }, "workspaceName": { "type": "string" }, "description": { "type": ["string", "null"], "maxLength": 2000 }, "attribution": { "type": "string" }, "attributionVerified": { "const": false }, "uploadedAt": { "type": "string", "format": "date-time" }, "capturedAt": { "type": ["string", "null"], "format": "date-time" }, "drawIB": { "type": "array", "items": { "type": "string" } }, "aliases": { "type": "array", "items": { "type": "string" } }, "metadataDownloadCount": { "type": "integer", "minimum": 0 }, "fullPackageDownloadCount": { "type": "integer", "minimum": 0 }, "fullDataAvailable": { "type": "boolean" }, "fullDataSize": { "type": "integer", "minimum": 0 }, "availability": { "enum": ["active", "possibly_outdated", "expired"] }, "reviewState": { "enum": ["not_required", "pending", "approved", "rejected"] }, "metadataPath": { "type": "string", "pattern": "^games/[^/]+/entries/[0-9a-f-]+/metadata\\.json$" } } } }
  }
}
